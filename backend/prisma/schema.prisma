generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id                  Int      @id @default(autoincrement())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  categoryTiktok      String?
  keyLazada           String?
  masterCategory      String
  price               Decimal
  pricePerGram        Decimal?
  productIdLazada     String?
  productIdShopee     String?
  productIdTiktok     String?
  productName         String
  quantityLazada      Int?
  quantityTiktok      Int?
  skuIdLazada         String?
  skuIdTiktok         String?
  stock               Int
  supplier            String
  variationIdShopee   String?
  variationNameLazada String?
  variationNameShopee String?
  variationNameTiktok String?
  gramRange           String?
  isManualPrice       Boolean  @default(false)
}
